cabal-version: 3.0
name: llambda-agent
version: 0.1.0.0
synopsis: Coding agent backed by the NVIDIA chat endpoint in llambda-agent.config
build-type: Simple

executable llambda-agent
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
      base >= 4.16 && < 5
    , aeson
    , bytestring
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , process
    , text
    , wai
    , warp
